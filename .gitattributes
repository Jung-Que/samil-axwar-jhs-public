# git 훅은 sh가 읽으므로 Windows(core.autocrlf=true)에서도 LF로 둔다.
tools/git-hooks/* text eol=lf
# Go 소스는 gofmt 기준(LF)으로 둔다. Windows에서 CRLF로 바뀌면 gofmt 검사가 실패한다.
server/**/*.go text eol=lf
server/go.mod text eol=lf
# 컨테이너 빌드가 읽는 파일도 LF로 둔다(CRLF면 RUN 줄 끝에 \r이 붙을 수 있다).
Dockerfile text eol=lf
.dockerignore text eol=lf
